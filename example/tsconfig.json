{
    "compilerOptions": {
        "esModuleInterop": true,
        "allowJs": false,
        "noImplicitAny": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "dist",
        "moduleResolution": "nodenext",
        "module": "nodenext",
        "lib": ["ES2022"],
        "target": "ES2022"
    },
    "exclude": ["node_modules", "dist"]
}
